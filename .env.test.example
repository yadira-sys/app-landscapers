# Copy to .env.test (gitignored) and fill in real values to run integration tests.
# .env.test is loaded by src/test/setup.ts via dotenv. If absent, integration
# tests are skipped (unit tests still run).
#
# Where to find these:
#   SUPABASE_URL — Supabase Dashboard → Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY — same page, "service_role" secret (DO NOT commit)

SUPABASE_URL=https://imngbfxhtkjntavwzwuv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Test fixtures — UUIDs of users with each role in the live project.
# These are read-only references; tests only generate sessions for them
# via admin generate_link, never modify the rows.
TEST_ADMIN_EMAIL=hola@tuadministrativa.es
TEST_ENCARGADO_EMAIL=juanfranciscocondecalvente@gmail.com
TEST_JARDINERO_EMAIL=felixsantiagoalegrelopez1@gmail.com

# Real PIN of the test jardinero (currently Felix, 6 digits).
# Update if PINs are rotated.
TEST_JARDINERO_PIN=353347
